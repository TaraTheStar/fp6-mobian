# Build environment for audioreach-topology (m4 -> alsatplg), Debian forky.
FROM docker.io/library/debian:forky-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake make m4 alsa-utils gcc g++ libc6-dev \
 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 builder
USER builder
