From ffc0385fdc44e967dcd49dc9095e956b9d8b6f55 Mon Sep 17 00:00:00 2001
From: Tara <tarathestar@proton.me>
Date: Wed, 11 Nov 2026 12:00:00 +0000
Subject: [PATCH 1/4] qcom: optional per-device mkbootimg_args

Some bootloaders want extra boot image header fields, such as
--os_version and --os_patch_level. A device entry can now pass them
through to mkbootimg.
---
 devices/qcom/bootloader.sh | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/devices/qcom/bootloader.sh b/devices/qcom/bootloader.sh
index 4fed22b..2268b98 100755
--- a/devices/qcom/bootloader.sh
+++ b/devices/qcom/bootloader.sh
@@ -55,6 +55,8 @@ for i in $(seq 0 $(tomlq -r '.device | length - 1' ${CONFIG})); do
     APPEND=$(tomlq -r "if .device[$i].append then .device[$i].append else \"\" end" ${CONFIG})
     # Extract device-specific bootimg parameters in JSON format for processing by `bootimg_offsets()`
     DEVICE_BOOTIMG=$(tomlq -r "if .device[$i].bootimg then .device[$i].bootimg else \"\" end" ${CONFIG})
+    # Optional extra mkbootimg arguments (e.g. --os_version/--os_patch_level)
+    EXTRA_ARGS=$(tomlq -r "if .device[$i].mkbootimg_args then .device[$i].mkbootimg_args else \"\" end" ${CONFIG})
 
     CMDLINE="mobile.qcomsoc=qcom/${DEVICE_SOC} mobile.vendor=${VENDOR} mobile.model=${MODEL}"
     if [ "${VARIANT}" ]; then
@@ -88,7 +90,7 @@ for i in $(seq 0 $(tomlq -r '.device | length - 1' ${CONFIG})); do
     cat /boot/vmlinuz-${KERNEL_VERSION} ${DTB_FILE} > /tmp/kernel-dtb
 
     # Create the bootimg as it's the only format recognized by the Android bootloader
-    mkbootimg -o /bootimg-${FULLMODEL} ${BOOTIMG_ARGS} \
+    mkbootimg -o /bootimg-${FULLMODEL} ${BOOTIMG_ARGS} ${EXTRA_ARGS} \
         --kernel /tmp/kernel-dtb --ramdisk /boot/initrd.img-${KERNEL_VERSION} \
         --cmdline "mobile.root=${ROOTPART} ${CMDLINE} init=/sbin/init ro ${LOGLEVEL} splash"
 done
