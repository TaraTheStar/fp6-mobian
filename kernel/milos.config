# Qualcomm Milos (SM7635) / Fairphone (Gen. 6) config fragment
#
# DRAFT 2026-11-10 - passes `make olddefconfig` on milos-mainline v7.3.0-milos
# with every requested symbol kept (tools/run-olddefconfig.sh + tools/fragcheck.py).
# Not yet compiled or booted.
# Target tree: milos-mainline v7.3.0-milos (40 patches on v7.3).
# Layering (debian/rules): debian.config + debian.arm64.config + mobian.config
# + this file, then olddefconfig. Only device deltas belong here; everything
# the Debian/Mobian layers already get right is deliberately absent.
# Style and y/m policy mirror sc7280.config (FP5): clocks + I2C built in,
# drivers as modules.

# SoC: pinctrl, clocks, interconnect
CONFIG_PINCTRL_MILOS=y
CONFIG_PINCTRL_MILOS_LPASS_LPI=m
CONFIG_SM_GCC_MILOS=y
CONFIG_SM_CAMCC_MILOS=y
CONFIG_SM_DISPCC_MILOS=y
CONFIG_SM_GPUCC_MILOS=y
CONFIG_SM_VIDEOCC_MILOS=y
CONFIG_SM_TCSRCC_8650=y
CONFIG_INTERCONNECT_QCOM_MILOS=y

# Display
CONFIG_DRM_PANEL_NOVATEK_NT37705=m

# Touchscreen (FROMLIST v3 driver in milos-mainline 7.3; the 7.2 queue used a
# downstream driver hooked in unconditionally, so this symbol did not exist there)
CONFIG_TOUCHSCREEN_ESWIN_EPH8621=m

# Haptics
CONFIG_INPUT_AW86927=m

# Storage: UFS inline crypto engine (milos.dtsi has qcom,milos-inline-crypto-engine).
# Without these the ICE is never built, stays unbound and holds gcc-milos
# sync_state (same as qcom-linux issue #60 on FP5; sdm845.config has these lines)
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y

# Sound (SND_SOC_SC8280XP machine driver is already =m in debian.arm64.config)
# Speakers: 2x AW88261 on MI2S
CONFIG_SND_SOC_AW88261=m
# Microphones: WCD9378 on SoundWire (driver from d/patches/catcrafts/; the plain
# milos-mainline DT has no codec node). tiol's WCD938X_SDW is not this codec.
CONFIG_SND_SOC_WCD9378_SDW=m

# Camera
# MEDIA_PLATFORM_SUPPORT is required: EXPERT=n below turns MEDIA_SUPPORT_FILTER
# on, which hides CAMSS and Iris unless platform drivers are requested explicitly
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# Ultra-wide
CONFIG_VIDEO_OV13B10=m
# Main camera + its OIS/AF controller (d/patches/catcrafts/)
CONFIG_VIDEO_IMX896=m
CONFIG_VIDEO_DW9784=m

# Sensors (IMU INV_ICM42600_SPI, barometer DPS310 and ALS/prox STK3310 are
# already =m in debian.config; their FP6 chip variants come from d/patches/catcrafts/)
CONFIG_QMC6308=m
# The VL53L3 ToF node uses "st,vl53l1x"; Catcrafts' tested config leaves
# VL53L1X_I2C off, so it stays off here too until someone tests it.

# Hardware RNG (TRNG in milos.dtsi)
CONFIG_HW_RANDOM_QCOM=m

# NFC (needs Catcrafts' S3NRN4V variant patch to actually probe on FP6)
CONFIG_NFC_NCI=m
CONFIG_NFC_S3FWRN5_I2C=m

# I2C system bus drivers
CONFIG_I2C_QCOM_CCI=y
CONFIG_I2C_QCOM_GENI=y

# Network
CONFIG_RMNET=m

# LEDs
CONFIG_LEDS_QCOM_FLASH=m

# Video
CONFIG_VIDEO_QCOM_IRIS=m

# Misc
CONFIG_NVMEM_REBOOT_MODE=y

###########################################################################
#
# Disable unused options to minimize kernel size (same as sc7280.config)
#
###########################################################################

# Userspace pd-mapper, as on sc7280 (also see d/patches/mobian/0049)
CONFIG_QCOM_PD_MAPPER=n

CONFIG_EXPERT=n
CONFIG_ACPI=n
CONFIG_ATA=n
# FP6 WiFi is WCN6755 over AHB, and the FP6 DT has no PCIe controller
CONFIG_PCI=n

# CPU IDLE has to be explicitly enabled, it was selected by CONFIG_ACPI
CONFIG_CPU_IDLE=y

CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_BITMAIN=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_SYNQUACER=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_SPRD=n
CONFIG_ARCH_THUNDER=n
CONFIG_ARCH_THUNDER2=n
CONFIG_ARCH_UNIPHIER=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_VISCONTI=n
CONFIG_ARCH_XGENE=n
CONFIG_ARCH_ZYNQMP=n
